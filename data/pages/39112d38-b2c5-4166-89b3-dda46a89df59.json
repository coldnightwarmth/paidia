  "blocks": [
    {
      "id": "game-description-39112d38-b2c5-4166-89b3-dda46a89df59-0",
      "type": "paragraph",
      "html": "The original Prince of Persia is a platform adventure about escaping a dungeon and reaching a captive princess before time runs out. Jumps, ledge grabs, sword fights, and traps require deliberate control: the protagonist’s momentum and vulnerability make a short stretch of corridor feel consequential."
    },
    {
      "id": "game-description-39112d38-b2c5-4166-89b3-dda46a89df59-1",
      "type": "paragraph",
      "html": "Jordan Mechner used filmed movement as a reference for rotoscoped animation, helping give the character an unusual sense of weight and continuity. Released first for the Apple II in 1989, the game began a series that later reinterpreted its setting and movement systems."
    },
