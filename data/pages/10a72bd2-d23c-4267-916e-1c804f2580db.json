              "type": "image",
              "src": "./assets/images/untitled-44d9559a76d5.webp",
              "caption": "",
              "alt": "Untitled"
            },
            {
              "id": "a3d7d742-09ae-496a-abd6-334f8b5b6481",
              "type": "columns",
