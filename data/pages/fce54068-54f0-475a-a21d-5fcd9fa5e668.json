    {
      "id": "6c48947e-a46b-4c75-9c36-d38d8df465cb",
      "type": "callout",
      "html": "Walking into interviews with well thought out questions can be incredibly helpful to showcase how your mind works with solving problems and to demonstrate areas of interest. The questions you ask in an interview are just as important as the questions you answer.<br><br>Add your own!",
      "icon": "💡",
      "children": []
    },
