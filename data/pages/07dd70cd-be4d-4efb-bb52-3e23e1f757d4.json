  "blocks": [
    {
      "id": "game-description-07dd70cd-be4d-4efb-bb52-3e23e1f757d4-0",
      "type": "paragraph",
      "html": "Simon is an electronic memory game with four illuminated colored buttons, each associated with a tone. The device plays a sequence and the player repeats it; successful repetitions extend the pattern. Difficulty comes from remembering and reproducing an increasingly long order rather than discovering a new rule."
    },
    {
      "id": "game-description-07dd70cd-be4d-4efb-bb52-3e23e1f757d4-1",
      "type": "paragraph",
      "html": "Designed by Ralph Baer and Howard Morrison, with programming by Lenny Cope, Simon was launched by Milton Bradley in 1978. Its combination of sound, light, and touch makes memory into a visible and audible performance that can be played alone or shared with others."
    }
  ],
