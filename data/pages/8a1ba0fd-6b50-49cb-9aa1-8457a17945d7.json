  "blocks": [
    {
      "id": "game-description-8a1ba0fd-6b50-49cb-9aa1-8457a17945d7-0",
      "type": "paragraph",
      "html": "The Last of Us follows Joel and Ellie across a United States transformed by a fungal pandemic. Encounters combine stealth, improvised tools, scavenging, and direct combat, with limited supplies making avoidance or preparation meaningful. Quiet stretches of travel and conversation connect the danger to the changing relationship between its two central characters."
    },
    {
      "id": "game-description-8a1ba0fd-6b50-49cb-9aa1-8457a17945d7-1",
      "type": "paragraph",
      "html": "Naughty Dog released the original game for PlayStation 3 in 2013. This entry concerns that release rather than its later remaster, remake, sequel, or television adaptation."
    },
