  "blocks": [
    {
      "id": "game-description-5192100e-1524-4aa4-9367-f79de5b596bc-0",
      "type": "paragraph",
      "html": "The first Call of Duty presents World War II through American, British, and Soviet campaigns. Rather than consistently treating the player as an isolated hero, its missions surround them with allied soldiers and staged battlefield events. Infantry combat is interspersed with vehicle sequences and objectives tied to the progress of a larger force."
    },
    {
      "id": "game-description-5192100e-1524-4aa4-9367-f79de5b596bc-1",
      "type": "paragraph",
      "html": "Developed by Infinity Ward for Windows, the 2003 game began the series that later expanded into other periods and settings. Its emphasis on squad presence and cinematic pacing helped define the early franchise’s identity."
    },
