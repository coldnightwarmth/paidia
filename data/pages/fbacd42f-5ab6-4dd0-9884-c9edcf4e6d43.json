  "blocks": [
    {
      "id": "game-description-fbacd42f-5ab6-4dd0-9884-c9edcf4e6d43-0",
      "type": "paragraph",
      "html": "Halo: Combat Evolved follows Master Chief and the artificial intelligence Cortana onto an immense ring-shaped world. Fighting the Covenant involves alternating between infantry encounters and vehicles, managing a regenerating shield, and choosing which two weapons to carry. Open combat areas contrast with enclosed installations and the discoveries inside them."
    },
    {
      "id": "game-description-fbacd42f-5ab6-4dd0-9884-c9edcf4e6d43-1",
      "type": "paragraph",
      "html": "Released with the Xbox in 2001, the game combined a science-fiction campaign with cooperative and competitive multiplayer. This entry uses the shorter title Halo for the original Combat Evolved, while recognizing that the name also identifies a much larger series."
    },
